{
  "name": "noteflow-api",
  "version": "0.0.1",
  "private": true,
  "description": "NoteFlow API - NestJS o'quv topshirig'i",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "migration:run:test": "dotenv -e .env.test -- typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "test": "jest -c test/jest.config.js --runInBand",
    "test:unit": "jest -c test/jest.config.js --runInBand --selectProjects unit",
    "test:e2e": "jest -c test/jest.config.js --runInBand --selectProjects e2e",
    "test:m1": "jest -c test/jest.config.js --runInBand m1-",
    "test:m2": "jest -c test/jest.config.js --runInBand m2-",
    "test:m3": "jest -c test/jest.config.js --runInBand m3-",
    "test:m4": "jest -c test/jest.config.js --runInBand m4-",
    "test:m5": "jest -c test/jest.config.js --runInBand m5-",
    "test:m6": "jest -c test/jest.config.js --runInBand m6-",
    "test:m7": "jest -c test/jest.config.js --runInBand m7-",
    "test:m8": "jest -c test/jest.config.js --runInBand m8-",
    "test:auth": "jest -c test/jest.config.js --runInBand m2-",
    "test:categories": "jest -c test/jest.config.js --runInBand m4-",
    "test:notes": "jest -c test/jest.config.js --runInBand m5- m6-",
    "test:upload": "jest -c test/jest.config.js --runInBand m8-"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
