# NoteFlow API - TEST sozlamalari.
# Nusxala:  cp .env.test.example .env.test
#
# MUHIM: test database development database'dan BUTUNLAY ALOHIDA bo'lishi shart.
# Testlar har safar jadvallardagi BARCHA ma'lumotlarni o'chiradi (TRUNCATE).
# Agar bu yerga noteflow_dev yozsang, o'z ma'lumotlaringni yo'qotasan.
# Test infratuzilmasi database nomi "_test" bilan tugamasa, ishlashni rad etadi.

NODE_ENV=test

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=noteflow
DB_PASSWORD=noteflow_pass
DB_DATABASE=noteflow_test    # <-- "_test" bilan tugashi SHART

JWT_SECRET=test_secret_only_for_tests
JWT_EXPIRES_IN=1h

# Testlar yuklangan fayllarni shu papkada saqlaydi va tozalaydi.
# Papka nomida "test" so'zi bo'lishi shart (xavfsizlik tekshiruvi).
UPLOAD_DIR=./uploads-test

PORT=3001
