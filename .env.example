# NoteFlow API - DEVELOPMENT sozlamalari.
# Bu faylni .env nomi bilan nusxala:  cp .env.example .env
# .env faylni HECH QACHON git'ga qo'shma (.gitignore'da bor).

# --- PostgreSQL ulanishi ---
DB_HOST=localhost            # PostgreSQL serveri joylashgan kompyuter manzili
DB_PORT=5432                 # PostgreSQL tinglaydigan port (standart: 5432)
DB_USERNAME=noteflow         # database user nomi
DB_PASSWORD=noteflow_pass    # shu user'ning paroli
DB_DATABASE=noteflow_dev     # DEVELOPMENT database nomi

# --- JWT ---
JWT_SECRET=dev_secret_change_me   # token imzolash uchun maxfiy kalit (uzun, tasodifiy qilib o'zgartir)
JWT_EXPIRES_IN=1h                 # token amal qilish muddati

# --- Fayl yuklash ---
UPLOAD_DIR=./uploads         # yuklangan fayllar saqlanadigan papka

# --- Server ---
PORT=3000
